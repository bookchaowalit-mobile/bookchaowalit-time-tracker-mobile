<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- iOS needs macOS to build; Linux hosts (incl. CI) build Android only. -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net8.0-ios</TargetFrameworks>
    <!-- Workload-free compile check of the shared XAML/C# (no Platforms/):
         dotnet build TimeTracker.csproj -p:MauiSharedCheck=true -->
    <TargetFrameworks Condition="'$(MauiSharedCheck)' == 'true'">net8.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net8.0'">Exe</OutputType>
    <RootNamespace>TimeTracker</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Time Tracker</ApplicationTitle>
    <ApplicationId>com.bookchaowalit.timetracker</ApplicationId>
    <ApplicationIdGuid>9d4ab6b7-5cf0-4a29-8fdf-f3464409ff0a</ApplicationIdGuid>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.*" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- core library and tests are separate projects; keep them out of the app's default globs -->
    <Compile Remove="src/**;tests/**" />
    <None Remove="src/**;tests/**" />
    <MauiXaml Remove="src/**;tests/**" />
    <ProjectReference Include="src/TimeTracker.Core/TimeTracker.Core.csproj" />
  </ItemGroup>

  <!-- The shared check has no platform head; platform code is only compiled by the real TFMs. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Platforms/**" />
    <None Remove="Platforms/**" />
  </ItemGroup>
</Project>
