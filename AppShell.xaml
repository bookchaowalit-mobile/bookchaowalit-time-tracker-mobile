<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:TimeTracker"
       x:Class="TimeTracker.AppShell"
       Title="Time Tracker">
    <TabBar>
        <ShellContent Title="Timer" ContentTemplate="{DataTemplate local:MainPage}" Route="timer" />
        <ShellContent Title="Reports" ContentTemplate="{DataTemplate local:ReportsPage}" Route="reports" />
    </TabBar>
</Shell>
